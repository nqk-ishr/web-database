# Sao chép thành .env và điền giá trị thật. KHÔNG commit file .env.

# PostgreSQL (VM 3)
POSTGRES_USER=vehicle_app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=vehicle_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend (VM 2)
DATABASE_URL=postgresql://vehicle_app:change_me@localhost:5432/vehicle_db
JWT_SECRET=change_me_long_random_string
JWT_EXPIRE_MINUTES=60

# Frontend (VM 1)
VITE_API_BASE_URL=http://localhost:8000

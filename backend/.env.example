# Backend (VM 2). Sao chép thành .env, KHÔNG commit.
DATABASE_URL=postgresql://vehicle_app:change_me@localhost:5432/vehicle_db
JWT_SECRET=change_me_long_random_string
JWT_EXPIRE_MINUTES=60
# Origin của frontend, phân tách bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Thư mục lưu tệp đính kèm (trên VM 3 / volume) và giới hạn mỗi tệp (byte)
UPLOAD_DIR=/var/app/uploads
MAX_UPLOAD_BYTES=5242880

// ============================================================
// HỆ THỐNG WEB QUẢN LÝ PHƯƠNG TIỆN GIAO THÔNG VÀ BẢO HIỂM - PostgreSQL
// Nghiệp vụ: Đăng ký, Sang tên | Phạt nguội | Bảo hiểm TNDS bắt buộc
// Dán nguyên file này vào https://dbdiagram.io
// ============================================================

Project vehicle_management_insurance {
  database_type: 'PostgreSQL'
  Note: 'CSDL Hệ thống Quản lý Phương tiện & Bảo hiểm xe cơ giới - 16 bảng, chuẩn hóa 3NF'
}

// ------------------------------------------------------------
// ENUM (Trạng thái & Luồng xử lý nghiệp vụ)
// ------------------------------------------------------------

Enum vehicle_status {
  Normal   [note: 'Bình thường']
  Stolen   [note: 'Báo mất (do duyệt bồi thường mất cắp)']
  Revoked  [note: 'Đã thu hồi (bởi cán bộ đăng ký)']
}

Enum registration_request_type {
  NewRegistration [note: 'Đăng ký mới']
  Transfer        [note: 'Sang tên']
}

Enum registration_request_status {
  PendingConfirmation    [note: 'Chờ bên mua xác nhận (đối với sang tên)']
  Pending                [note: 'Chờ cán bộ duyệt']
  Approved               [note: 'Đã duyệt']
  Rejected               [note: 'Từ chối']
  AdditionalInfoRequired [note: 'Cần bổ sung']
  Cancelled              [note: 'Đã hủy (do rút hồ sơ, bên mua từ chối, hoặc xe báo mất)']
}

Enum camera_status {
  Active
  Maintenance
  Inactive
}

Enum violation_status {
  Recorded  [note: 'Mới ghi nhận từ Camera']
  Verified  [note: 'Đã xác minh bởi cán bộ']
  Notified  [note: 'Đã thông báo ra quyết định']
  Paid      [note: 'Đã nộp phạt (trạng thái cuối)']
  Cancelled [note: 'Đã hủy (trạng thái cuối)']
}

Enum payment_status {
  Pending
  Success
  Failed
}

Enum policy_status {
  PendingPayment [note: 'Chờ thanh toán phí']
  Active         [note: 'Có hiệu lực']
  Cancelled      [note: 'Đã hủy']
}

Enum claim_type {
  Accident [note: 'Bồi thường tai nạn']
  Theft    [note: 'Bồi thường mất cắp toàn bộ xe']
}

Enum claim_status {
  Pending                [note: 'Chờ thẩm định']
  Approved               [note: 'Đã duyệt']
  Rejected               [note: 'Từ chối']
  AdditionalInfoRequired [note: 'Cần bổ sung']
  Paid                   [note: 'Đã chi trả (trạng thái cuối)']
  Cancelled              [note: 'Đã hủy (trạng thái cuối)']
}

// ============================================================
// NHÓM 1: NGƯỜI DÙNG VÀ DANH MỤC CẤU HÌNH
// ============================================================

Table roles {
  role_id   int [pk, increment]
  role_name varchar(50) [not null, unique, note: 'VehicleOwner, RegistrationOfficer, ViolationOfficer, InsuranceStaff, SystemAdmin']

  Note: 'Danh mục vai trò người dùng hệ thống'
}

Table insurers {
  insurer_id int [pk, increment]
  name       varchar(150) [not null, unique, note: 'Tên công ty bảo hiểm']
  tax_code   varchar(20) [not null, unique, note: 'Mã số thuế']
  address    text
  phone      varchar(20)
  email      varchar(100)
  created_at timestamp [not null, default: `now()`]

  Note: 'Danh mục các Công ty bảo hiểm tham gia hệ thống'
}

Table users {
  user_id       int [pk, increment]
  role_id       int [not null, ref: > roles.role_id]
  insurer_id    int [ref: > insurers.insurer_id, note: 'Bắt buộc với role InsuranceStaff (CHECK trong SQL)']
  full_name     varchar(100) [not null]
  identity_card varchar(20) [not null, unique, note: 'CCCD/CMND']
  email         varchar(100) [unique]
  phone         varchar(20) [unique]
  address       text
  password_hash varchar(255) [not null, note: 'Mật khẩu mã hóa']
  is_active     boolean [not null, default: true]
  created_at    timestamp [not null, default: `now()`]

  Note: 'Tài khoản người dùng dùng chung (gộp Chủ xe, Cán bộ và Nhân viên bảo hiểm)'
}

Table vehicle_types {
  type_id     int [pk, increment]
  type_name   varchar(50) [not null, unique, note: 'Ô tô con, Mô tô 2 bánh, Xe tải...']
  description text

  Note: 'Danh mục loại xe áp dụng cho đăng ký và tính phí bảo hiểm'
}

Table violation_types {
  violation_type_id int [pk, increment]
  violation_code    varchar(20) [not null, unique]
  violation_name    varchar(150) [not null]
  min_penalty       decimal(12,2) [not null, note: 'CHECK min_penalty >= 0']
  max_penalty       decimal(12,2) [not null, note: 'CHECK max_penalty >= min_penalty']
  description       text

  Note: 'Danh mục lỗi và khung mức phạt (có lỗi Không có bảo hiểm bắt buộc)'
}

Table cameras {
  camera_id         int [pk, increment]
  camera_code       varchar(30) [not null, unique]
  location          text [not null, note: 'Vị trí địa lý camera']
  installation_date date
  status            camera_status [not null, default: 'Active']

  Note: 'Camera phạt nguội (Tách bảng khỏi Violations để đạt chuẩn 3NF)'
}

// ============================================================
// NHÓM 2: PHƯƠNG TIỆN VÀ LỊCH SỬ SỞ HỮU
// ============================================================

Table vehicles {
  vehicle_id       int [pk, increment]
  license_plate    varchar(15) [unique, note: 'Biển số (NULL khi chưa duyệt hồ sơ đăng ký mới)']
  frame_number     varchar(50) [not null, unique, note: 'Số khung']
  engine_number    varchar(50) [not null, unique, note: 'Số máy']
  model_name       varchar(100) [not null, note: 'Tên dòng xe / mẫu xe']
  manufacture_year int [not null, note: 'Năm sản xuất. CHECK trong khoảng 1900..Năm hiện tại']
  type_id          int [not null, ref: > vehicle_types.type_id]
  status           vehicle_status [not null, default: 'Normal', note: 'Bình thường | Báo mất | Đã thu hồi']
  created_at       timestamp [not null, default: `now()`]

  indexes {
    license_plate
    (type_id, status)
  }

  Note: 'Bảng phương tiện giao thông chính'
}

Table ownership_history {
  ownership_id int [pk, increment]
  vehicle_id   int [not null, ref: > vehicles.vehicle_id]
  owner_id     int [not null, ref: > users.user_id, note: 'FK tới bảng users (role VehicleOwner)']
  valid_during daterange [not null, note: 'Khoảng thời gian sở hữu [từ ngày, đến ngày)']
  created_at   timestamp [not null, default: `now()`]

  indexes {
    (vehicle_id, valid_during) [type: gist]
  }

  Note: '''
  Lịch sử chủ sở hữu phương tiện.
  - EXCLUDE USING gist (vehicle_id WITH =, valid_during WITH &&) -> Không cho phép chồng lấn thời gian sở hữu
  - UNIQUE partial: (vehicle_id) WHERE upper_inf(valid_during) -> Duy nhất 1 chủ sở hữu hiện hành
  '''
}

Table registration_requests {
  request_id       int [pk, increment]
  request_type     registration_request_type [not null, note: 'NewRegistration | Transfer']
  seller_id        int [ref: > users.user_id, note: 'Chủ hiện tại / Bên bán (NULL nếu Đăng ký mới)']
  buyer_id         int [not null, ref: > users.user_id, note: 'Chủ mới / Bên mua']
  vehicle_id       int [ref: > vehicles.vehicle_id, note: 'Xe cần sang tên (NULL nếu Đăng ký mới chưa tạo xe)']
  
  // Thông tin kê khai cho đăng ký mới
  frame_number     varchar(50)
  engine_number    varchar(50)
  model_name       varchar(100)
  manufacture_year int
  type_id          int [ref: > vehicle_types.type_id]

  status           registration_request_status [not null, default: 'PendingConfirmation']
  rejection_reason text
  approved_by      int [ref: > users.user_id, note: 'Cán bộ đăng ký duyệt']
  created_at       timestamp [not null, default: `now()`]
  updated_at       timestamp [not null, default: `now()`]

  indexes {
    (vehicle_id, status)
    buyer_id
  }

  Note: '''
  Hồ sơ đăng ký mới & sang tên.
  - UNIQUE partial: (vehicle_id) WHERE status IN ('PendingConfirmation', 'Pending', 'AdditionalInfoRequired') -> Tối đa 1 hồ sơ đang mở
  '''
}

Table vehicle_status_history {
  history_id int [pk, increment]
  vehicle_id int [not null, ref: > vehicles.vehicle_id]
  old_status vehicle_status [not null]
  new_status vehicle_status [not null]
  reason     text [not null, note: 'Lý do thay đổi (báo mất do bảo hiểm, thu hồi, tìm thấy...)']
  changed_by int [not null, ref: > users.user_id, note: 'Người thực hiện thao tác']
  changed_at timestamp [not null, default: `now()`]

  Note: 'Nhật ký theo dõi biến động trạng thái xe (Bình thường <-> Báo mất -> Thu hồi)'
}

// ============================================================
// NHÓM 3: VI PHẠM PHẠT NGUỘI VÀ NỘP PHẠT
// ============================================================

Table violations {
  violation_id      int [pk, increment]
  vehicle_id        int [ref: > vehicles.vehicle_id, note: 'NULL nếu biển số camera ghi không có trong hệ thống']
  license_plate     varchar(15) [not null, note: 'Biển số do camera nhận diện']
  violator_id       int [ref: > users.user_id, note: 'Chủ xe chịu phạt tại thời điểm vi phạm (tra cứu từ OwnershipHistory)']
  camera_id         int [ref: > cameras.camera_id]
  violation_type_id int [not null, ref: > violation_types.violation_type_id]
  violation_time    timestamp [not null, note: 'Thời điểm xảy ra vi phạm']
  fine_amount       decimal(12,2) [note: 'Số tiền phạt cố định khi lập biên bản. CHECK trong khung min_penalty..max_penalty']
  decision_number   varchar(50) [unique, note: 'Số quyết định xử phạt']
  due_date          date [note: 'Hạn nộp phạt (Quá hạn suy ra từ CURRENT_DATE > due_date)']
  status            violation_status [not null, default: 'Recorded']
  verified_by       int [ref: > users.user_id, note: 'Cán bộ xử lý vi phạm xác minh']
  created_at        timestamp [not null, default: `now()`]

  indexes {
    (vehicle_id, status)
    violation_time
    violator_id
  }

  Note: 'Bảng vi phạm phạt nguội (quy mô dữ liệu 100.000+ bản ghi để đo hiệu năng)'
}

Table payments {
  payment_id       int [pk, increment]
  violation_id     int [not null, ref: > violations.violation_id]
  base_fine        decimal(12,2) [not null, note: 'Tiền phạt gốc']
  late_fee         decimal(12,2) [not null, default: 0, note: 'Phạt trễ tính theo tỷ lệ ngày quá hạn']
  total_amount     decimal(12,2) [note: 'Tổng tiền = base_fine + late_fee (Generates dynamically/stored)']
  payment_method   varchar(50) [default: 'SimulatedGateway', note: 'Cổng thanh toán mô phỏng']
  transaction_code varchar(100) [unique, note: 'Mã giao dịch ngân hàng/ví']
  status           payment_status [not null, default: 'Pending']
  payment_time     timestamp [not null, default: `now()`]

  indexes {
    violation_id
    status
  }

  Note: '''
  Giao dịch thanh toán nộp phạt.
  - UNIQUE partial: (violation_id) WHERE status = 'Success' -> Tối đa 1 giao dịch nộp phạt thành công cho mỗi vi phạm
  '''
}

// ============================================================
// NHÓM 4: BẢO HIỂM TRÁCH NHIỆM DÂN SỰ & BỒI THƯỜNG
// ============================================================

Table insurance_products {
  product_id               int [pk, increment]
  insurer_id               int [not null, ref: > insurers.insurer_id]
  type_id                  int [not null, ref: > vehicle_types.type_id]
  product_name             varchar(150) [not null, note: 'Tên gói bảo hiểm']
  premium_fee              decimal(12,2) [not null, note: 'Phí bảo hiểm/năm. CHECK > 0']
  coverage_duration_months int [not null, note: 'Thời hạn gói (tháng). CHECK > 0']
  max_coverage_limit       decimal(12,2) [not null, note: 'Hạn mức bồi thường tối đa. CHECK > 0']
  includes_theft_benefit   boolean [not null, default: false, note: 'Gói mở rộng có quyền lợi mất cắp toàn bộ xe']
  is_active                boolean [not null, default: true]
  created_at               timestamp [not null, default: `now()`]

  Note: 'Danh mục các gói bảo hiểm của từng công ty'
}

Table insurance_policies {
  policy_id   int [pk, increment]
  vehicle_id  int [not null, ref: > vehicles.vehicle_id]
  product_id  int [not null, ref: > insurance_products.product_id]
  buyer_id    int [not null, ref: > users.user_id, note: 'Chủ xe hiện hành mua hợp đồng']
  start_date  date [not null]
  end_date    date [not null, note: 'CHECK end_date > start_date (Hết hạn suy ra từ CURRENT_DATE > end_date)']
  premium_fee decimal(12,2) [not null, note: 'Sao chép mức phí tại thời điểm mua (sao chụp dữ liệu)']
  status      policy_status [not null, default: 'PendingPayment']
  created_at  timestamp [not null, default: `now()`]

  indexes {
    (vehicle_id, start_date, end_date)
    buyer_id
  }

  Note: '''
  Hợp đồng bảo hiểm xe cơ giới (Hợp đồng gắn với xe, không gắn với chủ).
  - EXCLUDE USING gist (vehicle_id WITH =, daterange(start_date, end_date, '[]') WITH &&) WHERE status = 'Active' -> Không trùng khoảng hiệu lực
  - UNIQUE partial: (vehicle_id) WHERE status = 'PendingPayment' -> Tối đa 1 hợp đồng chờ thanh toán cho mỗi xe
  '''
}

Table policy_payments {
  policy_payment_id int [pk, increment]
  policy_id         int [not null, ref: > insurance_policies.policy_id]
  amount            decimal(12,2) [not null, note: 'Số tiền phí bảo hiểm']
  payment_method    varchar(50) [default: 'SimulatedGateway']
  transaction_code  varchar(100) [unique]
  status            payment_status [not null, default: 'Pending']
  payment_time      timestamp [not null, default: `now()`]

  Note: '''
  Giao dịch thanh toán phí bảo hiểm.
  - UNIQUE partial: (policy_id) WHERE status = 'Success' -> Tối đa 1 giao dịch mua bảo hiểm thành công cho mỗi hợp đồng
  '''
}

Table insurance_claims {
  claim_id          int [pk, increment]
  policy_id         int [not null, ref: > insurance_policies.policy_id]
  claim_type        claim_type [not null, note: 'Accident (Tai nạn) | Theft (Mất cắp)']
  claimant_id       int [not null, ref: > users.user_id, note: 'Người yêu cầu bồi thường (Tai nạn: chủ tại thời điểm xảy ra; Mất cắp: chủ hiện tại)']
  incident_time     timestamp [not null, note: 'Thời điểm xảy ra sự cố (CHECK không ở tương lai)']
  incident_location text [not null]
  description       text [not null, note: 'Mô tả diễn biến sự cố']
  requested_amount  decimal(12,2) [not null, note: 'Số tiền đề nghị bồi thường. CHECK > 0']
  approved_amount   decimal(12,2) [note: 'Số tiền duyệt bồi thường. CHECK approved_amount <= requested_amount']
  status            claim_status [not null, default: 'Pending']
  reviewed_by       int [ref: > users.user_id, note: 'Nhân viên bảo hiểm thẩm định']
  created_at        timestamp [not null, default: `now()`]
  updated_at        timestamp [not null, default: `now()`]

  indexes {
    policy_id
    status
  }

  Note: '''
  Hồ sơ yêu cầu bồi thường bảo hiểm.
  - Duyệt bồi thường Mất cắp (Theft) sẽ tự động kích hoạt Transaction: Chuyển trạng thái xe sang Stolen, Hủy các hồ sơ đăng ký/sang tên và hợp đồng bảo hiểm đang chờ của xe.
  - UNIQUE partial: (policy_id) WHERE claim_type = 'Theft' AND status IN ('Pending', 'AdditionalInfoRequired') -> Tối đa 1 yêu cầu mất cắp đang mở
  '''
}